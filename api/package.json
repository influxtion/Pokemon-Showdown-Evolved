{
  "name": "showdown-practice-api",
  "version": "1.0.0",
  "private": true,
  "description": "Practice bot inference API for Pokemon Showdown Evolved. Computes Foul Play's moves for battles run by the client.",
  "license": "AGPL-3.0-or-later",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node install.js",
    "setup:metamon": "node metamon/install.js",
    "status": "node install.js --status",
    "refresh-ou": "node install.js --refresh-ou",
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ws": "8.23.0"
  }
}
